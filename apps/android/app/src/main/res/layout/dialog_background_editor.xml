<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/ui_sheet_surface">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp"
        android:text="背景大小与位置" android:textStyle="bold" android:textSize="19sp" android:textColor="@color/ui_text_secondary"/>
    <FrameLayout android:id="@+id/previewSlot" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/previewCanvas" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@color/ui_background">
            <ImageView android:id="@+id/previewImage" android:layout_width="match_parent" android:layout_height="match_parent"
                android:importantForAccessibility="no" android:src="@drawable/ui_bg_aurora"/>
            <View android:id="@+id/previewTouch" android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="拖动或捏合调整背景"/>
        </FrameLayout>
    </FrameLayout>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/videoSound" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginTop="6dp" android:visibility="gone"
        android:text="视频声音" android:textColor="@color/ui_text_secondary"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/cancelPlacement" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:background="@drawable/ui_chip" android:gravity="center"
            android:text="取消" android:textColor="@color/ui_text_secondary" android:focusable="true"/>
        <TextView android:id="@+id/resetPlacement" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:background="@drawable/ui_chip" android:gravity="center"
            android:text="复位" android:textColor="@color/ui_text_secondary" android:focusable="true"/>
        <TextView android:id="@+id/savePlacement" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:background="@drawable/ui_chip_selected" android:gravity="center"
            android:text="保存" android:textColor="@color/ui_text_secondary" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
