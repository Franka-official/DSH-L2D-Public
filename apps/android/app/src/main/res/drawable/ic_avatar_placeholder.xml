<?xml version="1.0" encoding="utf-8"?>
<!-- M1 占位立绘：深底 + 青色光环（普猫猫白色发光眼的意象） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_deep" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="360dp" android:height="360dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#2A4A44"
                android:endColor="#0B1016" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="84dp" android:height="84dp" />
            <solid android:color="#EAF7F2" />
        </shape>
    </item>
</layer-list>
